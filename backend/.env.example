# Copy to .env (never commit .env). See docs/DEPLOYMENT.md.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
SCHEDULER_SECRET=dev-scheduler-secret

# Email: leave EMAIL_HOST empty to print emails in the runserver console.
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cadence <no-reply@cadence.local>

# Password for the demo users created by `python manage.py seed_demo` (local only).
DEMO_PASSWORD=Brightloop@2026
